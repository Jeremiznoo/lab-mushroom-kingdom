    .wrap{max-width:1120px;margin:0 auto;padding:0 24px 72px}.header{height:82px;display:flex;align-items:center;gap:28px}.brand{display:flex;align-items:center;gap:12px;margin-right:auto}.mark{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:var(--red);color:var(--gold);font-size:23px;box-shadow:0 5px 0 #751f25;overflow:hidden}.mark img{width:100%;height:100%;object-fit:contain}.brand b{display:block;font-size:15px;letter-spacing:.1em}.brand small{display:block;margin-top:4px;color:var(--red);font-size:9px;letter-spacing:.14em}.nav{display:flex;gap:22px;color:#80666a;font-size:12px;font-weight:bold}.nav a.active,.nav a:hover{color:var(--red)}.upload-button{padding:11px 15px;border-radius:10px;background:var(--gold);color:#5d3d0b;font-size:11px;font-weight:bold;box-shadow:0 3px 0 #a87519}.upload-button:hover{transform:translateY(-2px)}
    .hero{position:relative;min-height:285px;overflow:hidden;border:5px solid #fff;border-radius:25px;background:linear-gradient(100deg,#6f1b20e8,#ce4d2cb8),url('/assets/background-lava.png') center/cover;box-shadow:0 20px 55px #42111670}.copy{position:relative;z-index:2;max-width:550px;padding:42px 43px}.eyebrow{color:var(--gold);font-size:10px;font-weight:bold;letter-spacing:.17em}.hero h1{margin:13px 0 10px;color:#fff9ee;font-size:42px;line-height:1;letter-spacing:-.04em;text-shadow:3px 4px 0 #4d171c99}.hero p{max-width:430px;color:#ffe6c9;font-size:14px;line-height:1.5;font-weight:bold}.hero img{position:absolute;right:12px;bottom:-62px;height:380px;filter:drop-shadow(0 20px 12px #3b101080)}.badge{position:absolute;right:28px;top:22px;z-index:3;padding:8px 12px;color:#fff;border:3px solid #fff;border-radius:7px;background:var(--red);font-size:10px;font-weight:bold;transform:rotate(4deg);box-shadow:0 4px 0 #791f25}
    .heading{display:flex;align-items:end;justify-content:space-between;margin:30px 0 14px}.heading h2{margin:7px 0 0;font-size:25px;letter-spacing:-.04em}.heading p{margin:0;color:var(--muted);font-size:12px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:23px}.threads{display:grid;gap:11px}.thread{background:#fffdf9ed;border:1px solid var(--line);border-radius:16px;box-shadow:0 8px 24px #63281b0d;overflow:hidden}.thread summary{display:flex;align-items:flex-start;gap:13px;padding:16px 17px;cursor:pointer;list-style:none}.thread summary::-webkit-details-marker{display:none}.thread summary:hover{background:#fff8ef}.thread summary:after{content:'+';margin:10px 0 0 auto;color:#c79a8f;font-size:23px;font-weight:normal}.thread[open] summary:after{content:'−'}.avatar{width:47px;height:47px;flex:none;display:grid;place-items:center;border-radius:15px;color:#fff;font-size:16px;font-weight:bold;box-shadow:inset 0 -6px 13px #0003}.bowser{background:linear-gradient(145deg,#4b8b4e,#1c4e35)}.jr{background:linear-gradient(145deg,#f5b93e,#c96725)}.lemmy{background:linear-gradient(145deg,#54c7e9,#4364ca)}.wendy{background:linear-gradient(145deg,#ed71a0,#a83976)}.goomba{background:linear-gradient(145deg,#a86d4a,#633d38)}.summary-main{min-width:0;flex:1}.meta{display:flex;align-items:center;gap:8px;margin-bottom:4px}.meta b{font-size:12px}.meta time{color:#ad9291;font-size:10px}.tag{padding:4px 7px;border-radius:5px;font-size:8px;font-weight:bold;letter-spacing:.1em}.alert{color:#a83232;background:#ffe5e2}.plan{color:#8c5e08;background:#fff0c5}..chat{color:#4862a9;background:#e9edff}..guard{color:#9a4d25;background:#ffeadb}.summary-main h3{font-size:15px;margin:0 0 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.summary-main p{color:var(--muted);font-size:12px;line-height:1.45;margin:0}
    .conversation{margin:0 17px 16px 77px;padding:13px 15px;border-top:1px solid var(--line);background:#fff8ef;border-radius:0 0 12px 12px}.msg{padding:8px 0;border-bottom:1px solid #f2dfd3;font-size:12px;line-height:1.45}.msg:last-child{border-bottom:0}.msg b{color:var(--red);font-size:11px}.msg span{color:#5e4a4c}.side{display:grid;align-content:start;gap:14px}.panel{background:#fffdf9ed;border:1px solid var(--line);border-radius:17px;padding:20px;box-shadow:0 10px 28px #63281b0d}.panel h3{font-size:18px;margin:8px 0 5px}.panel p{color:var(--muted);font-size:12px;line-height:1.5}.panel-icon{color:var(--orange);font-size:22px}.upload-card{border-top:4px solid var(--red)}.big-button{display:block;margin-top:16px;padding:13px 14px;text-align:center;border-radius:10px;background:var(--red);color:#fff;font-size:12px;font-weight:bold;box-shadow:0 4px 0 #781f26}.big-button:hover{transform:translateY(-2px)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:15px}.stat{padding:11px 5px;text-align:center;background:#fff7eb;border-radius:10px}.stat b{display:block;color:var(--red);font-size:18px}.stat span{color:var(--muted);font-size:9px;font-weight:bold}.footer{margin-top:20px;color:#ffe1cf;font-size:11px;font-weight:bold}.footer span{float:right;color:var(--gold)}
    @media(max-width:820px){.layout{grid-template-columns:1fr}.side{grid-template-columns:1fr 1fr}.hero img{right:-90px;opacity:.65}.copy{max-width:100%}}
    @media(max-width:600px){.top span,.nav{display:none}.wrap{padding-left:16px;padding-right:16px}.header{height:70px}.upload-button{padding:9px 10px;font-size:10px}.hero{min-height:360px}.copy{padding:37px 24px}.hero h1{font-size:36px}.hero img{height:300px;right:-82px;bottom:-32px}.badge{right:14px}.side{grid-template-columns:1fr}.thread summary{padding:14px 12px;gap:10px}.avatar{width:41px;height:41px;border-radius:12px}.summary-main h3{font-size:13px}.conversation{margin-left:63px}}
    .pinned{border:2px solid var(--gold);box-shadow:0 10px 28px #8a541f22}.pinned .conversation{background:#fff4d8}.evidence-photo{display:block;width:min(100%,520px);margin:12px 0 4px;border:4px solid #fff;border-radius:12px;box-shadow:0 7px 18px #63281b22}.threads .thread:nth-child(2){order:-1}.thread[open] summary:after{content:'-'}.upload-icon{display:inline-flex;width:28px;height:28px;align-items:center;justify-content:center;color:var(--red)}.upload-icon svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
